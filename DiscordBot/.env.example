# Discord
DISCORD_TOKEN=your-bot-token-here
GUILD_ID=000000000000000000          # your server id (for instant slash-command sync)
ADMIN_ROLE_ID=000000000000000000     # role allowed to run /restart (guild admins always allowed)

# Channels
STATUS_CHANNEL_ID=000000000000000000   # where the live status embed lives
ANNOUNCE_CHANNEL_ID=000000000000000000 # restart announcements; defaults to STATUS_CHANNEL_ID if blank

# MySQL (same database the Unturned plugins use)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=unturned
DB_USER=root
DB_PASSWORD=123456

# Must match the plugin's Database.TablePrefix
SR_PREFIX=sr_

# Display
SERVER_NAME=Unturned Server
TZ_OFFSET_HOURS=7        # Thailand; next_restart is stored UTC and shown in this offset

# Loop cadence (seconds)
EMBED_REFRESH_SECONDS=30
EVENT_POLL_SECONDS=10
STALE_AFTER_SECONDS=90   # status older than this => shown as offline
